*.xcworkspace/

# --- Resultados de compilación ---
build/
DerivedData/
dist/
verificar/
Payload/
*.ipa
*.app
*.dSYM
*.dSYM.zip
*.xcarchive

# --- Archivos personales de Xcode ---
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.moved-aside

# --- Paquetes de Swift ---
.build/
.swiftpm/

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Claves, certificados y secretos: NUNCA al repositorio ---
.env
.env.*
*.p12
*.p8
*.pem
*.key
*.cer
*.mobileprovision
*.provisionprofile
secrets/

# --- Datos personales de Claude Code (solo en esta PC) ---
CLAUDE.local.md

# --- Bocetos de diseño (no son parte de la app) ---
.diseno/
