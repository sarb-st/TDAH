*.moved-aside

# --- Paquetes de Swift ---
.build/
.swiftpm/

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Claves, certificados y secretos: NUNCA al repositorio ---
.env
.env.*
*.p12
*.p8
*.pem
*.key
*.cer
*.mobileprovision
*.provisionprofile
secrets/
